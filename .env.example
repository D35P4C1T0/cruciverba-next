# Evento
CELEBRATED_PERSON_NAME=Bianca

# Dominio pubblico senza schema, richiesto solo in produzione.
PUBLIC_HOSTNAME=cruciverba.example.it

# Segreti: sostituire tutti prima di pubblicare.
FORM_PASSWORD=cambia-questa-password-lunga
ADMIN_PASSWORD=cambia-questa-password-admin-lunga
SECRET_KEY=incolla-qui-64-caratteri-casuali
ALLOW_WEAK_PASSWORDS=False

# Proxy di produzione
TRAEFIK_NETWORK=traefik
TRUSTED_PROXY_COUNT=1

# Porta locale (non pubblicata dal Compose di produzione)
BIND_ADDRESS=127.0.0.1
APP_PORT=5000

# Opzioni: i valori predefiniti bastano per una singola istanza.
# CONTAINER_NAME=cruciverba
# APP_IMAGE=cruciverba:local
# RATE_LIMIT_DEFAULT=120 per minute
# RATE_LIMIT_LOGIN=10 per minute
# GUNICORN_THREADS=4
