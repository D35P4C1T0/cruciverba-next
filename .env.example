# Evento
CELEBRATED_PERSON_NAME=Bianca

# Dominio pubblico senza schema. Obbligatorio con docker-compose.prod.yml.
PUBLIC_HOSTNAME=cruciverba.example.it

# Segreti: sostituire tutti prima di pubblicare.
FORM_PASSWORD=cambia-questa-password-lunga
ADMIN_PASSWORD=cambia-questa-password-admin-lunga
SECRET_KEY=incolla-qui-64-caratteri-casuali

# Rete
BIND_ADDRESS=127.0.0.1
APP_PORT=5000

# Numero esatto di reverse proxy fidati davanti all'app.
TRUSTED_PROXY_COUNT=1
